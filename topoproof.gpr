with "topodraw_lib.gpr";

project TopoProof is

   --  Build profiles, selected with the Topoproof_Build_Profile external:
   --    development (default): checks and contracts verified at run time
   --    release: proved checks suppressed on the kernel, kept on the CLI
   type Build_Profile_Kind is ("release", "development");
   Build_Profile : Build_Profile_Kind :=
     External ("Topoproof_Build_Profile", "development");

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("topoproof_cli.adb");

   package Builder is
      for Executable ("topoproof_cli.adb") use "topoproof";
   end Builder;

   --  The SPARK kernel units are proved free of run-time errors (silver
   --  baseline, see docs/manifesto.md): in the release profile their
   --  run-time checks are suppressed with -gnatp, which is the payoff of
   --  the proof. The suppression lives here, in the build configuration
   --  only: never in the sources, because GNATprove honours pragma
   --  Suppress and would stop checking the silver property.
   --  The command-line interface keeps its checks in every profile: its
   --  input validation relies on Constraint_Error for out-of-domain
   --  parameters.
   Kernel_Switches := ("-gnat2022", "-gnatwa", "-gnatf",
                      "-gnatyabefhiklnprtx");
   --  Style checking :
   --  a : Check attribute casing
   --  b : Blanks not allowed at statement end
   --  e : Check end/exit labels
   --  f : No form feeds or vertical tabs
   --  h : No horizontal tabs
   --  i : Check if-then layout
   --  k : Check keyword casing
   --  l : Check layout
   --  n : Check casing of entities in Standard
   --  p : Check pragma casing
   --  r : Check references
   --  t : Check token spacing
   --  x : Check extra parentheses
   --  No maximum line length: GNATformat (width 100) owns the layout.

   package Compiler is
      case Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use
              Kernel_Switches & ("-O2", "-gnatp");
            --  The interface keeps its run-time checks: it validates
            --  external input before it enters the proved kernel.
            for Switches ("topoproof_cli.adb") use
              Kernel_Switches & ("-O2", "-gnatVa");
         when others =>
            for Default_Switches ("Ada") use
              Kernel_Switches & ("-gnatVa", "-gnata");
      end case;
   end Compiler;

   package Format is
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "3";
      for Width ("Ada") use "100";
   end Format;

end TopoProof;
