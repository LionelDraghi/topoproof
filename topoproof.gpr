--  The proved kernel: the SPARK units in src/, analysed by GNATprove
--  (make prove). The command-line client lives in tools/topocli and
--  withs this project; it is not part of the proof scope.
project TopoProof is

   --  Build profiles, selected with the Topoproof_Build_Profile external
   --  (the Alire [build-profiles] pin drives it for every alr command):
   --    development: fast edit loop, no contract or run-time check in the
   --      generated code, style and warnings still enforced
   --    validation (default): the working profile, every check and
   --      contract embedded (-gnata, -gnatVa); every push goes through a
   --      green validation build
   --    release: proved checks suppressed on the kernel (-gnatp, -O2),
   --      the payoff of the proof; the client keeps its own checks in
   --      every profile (see tools/topocli/topocli.gpr)
   type Build_Profile_Kind is ("development", "validation", "release");
   Build_Profile : Build_Profile_Kind :=
     External ("Topoproof_Build_Profile", "validation");

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   --  The SPARK kernel units are proved free of run-time errors (silver
   --  baseline, see docs/manifesto.md): in the release profile their
   --  run-time checks are suppressed with -gnatp, which is the payoff of
   --  the proof. The suppression lives here, in the build configuration
   --  only: never in the sources, because GNATprove honours pragma
   --  Suppress and would stop checking the silver property.
   --  Warnings are errors: a style violation (trailing blanks, layout,
   --  casing) or any other warning fails every build, locally and in CI.
   --  The GNATprove runs of make prove use their own flag
   --  (--warnings=error), and the style switches apply there too.
   Kernel_Switches := ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
                      "-gnatyabefhiklnprtx");
   --  Style checking :
   --  a : Check attribute casing
   --  b : Blanks not allowed at statement end
   --  e : Check end/exit labels
   --  f : No form feeds or vertical tabs
   --  h : No horizontal tabs
   --  i : Check if-then layout
   --  k : Check keyword casing
   --  l : Check layout
   --  n : Check casing of entities in Standard
   --  p : Check pragma casing
   --  r : Check references
   --  t : Check token spacing
   --  x : Check extra parentheses
   --  No maximum line length: GNATformat (width 100) owns the layout.

   package Compiler is
      case Build_Profile is
         when "development" =>
            --  Contracts are compiled out in this profile and in
            --  release, so parameters referenced from contracts only
            --  are seen as unreferenced by the front end; the -gnatwF
            --  suppression removes that class. Validation keeps it:
            --  there, a formal unreferenced even from the contracts is
            --  a real problem, and every other warning stays an error.
            for Default_Switches ("Ada") use
              Kernel_Switches & ("-gnatwF");
         when "validation" =>
            for Default_Switches ("Ada") use
              Kernel_Switches & ("-gnatVa", "-gnata");
         when "release" =>
            for Default_Switches ("Ada") use
              Kernel_Switches & ("-O2", "-gnatp", "-gnatwF");
      end case;
   end Compiler;

   package Format is
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "3";
      for Width ("Ada") use "100";
   end Format;

end TopoProof;
