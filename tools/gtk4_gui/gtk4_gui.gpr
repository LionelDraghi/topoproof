with "gtkada";

project Gtk4_Gui is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("gtk4_gui-main.adb");

   package Builder is
      for Executable ("gtk4_gui-main.adb") use "gtk4_gui";
   end Builder;

   type Build_Profile_Kind is ("release", "development");
   Build_Profile : Build_Profile_Kind :=
     External ("Gtk4_Gui_Build_Profile", "development");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
         "-gnatyabefhiklnprtx");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,-rpath,$ORIGIN");
   end Linker;

end Gtk4_Gui;
