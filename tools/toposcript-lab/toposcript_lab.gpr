with "hac";
with "../../topoproof.gpr";

--  The TopoScript feasibility prototype (development plan, Milestone 6,
--  Increment 1): it embeds the HAC interpreter and runs a script source
--  against the proved kernel operations, through native callbacks. The
--  kernel (topoproof.gpr) is the proved part; this project keeps its
--  run-time checks in every profile, because the script data crosses
--  type boundaries through HAC elements, and out-of-domain values are
--  rejected by Constraint_Error. Warnings are errors: a style violation
--  or any other warning fails every build, locally and in CI.
project Toposcript_Lab is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "../../bin";
   for Main use ("toposcript_lab.adb");

   package Builder is
      for Executable ("toposcript_lab.adb") use "toposcript_lab";
   end Builder;

   --  Build profiles, selected with the same external as the kernel, so
   --  that one -X switch on the command line drives every project.
   type Build_Profile_Kind is ("release", "development");
   Build_Profile : Build_Profile_Kind :=
     External ("Topoproof_Build_Profile", "development");

   Client_Switches := ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
                      "-gnatyabefhiklnprtx");
   --  Style checking: same set as the kernel, see topoproof.gpr.
   --  No maximum line length: GNATformat (width 100) owns the layout.

   package Compiler is
      case Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use
              Client_Switches & ("-O2", "-gnatVa");
         when others =>
            for Default_Switches ("Ada") use
              Client_Switches & ("-gnatVa", "-gnata");
      end case;
   end Compiler;

   package Format is
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "3";
      for Width ("Ada") use "100";
   end Format;

end Toposcript_Lab;
