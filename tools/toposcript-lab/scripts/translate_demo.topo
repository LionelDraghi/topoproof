--  TopoScript feasibility prototype: the script is compiled and run by
--  the HAC interpreter embedded in toposcript_lab; the Translate import
--  calls the proved TopoProof operation through the native callback.

with HAT;

procedure Translate_Demo is

   procedure Translate (X, Y, Z, DX, DY, DZ : in out Integer)
      with Import => True;

   X  : Integer := 10;
   Y  : Integer := -20;
   Z  : Integer := 30;
   DX : Integer := 5;
   DY : Integer := 7;
   DZ : Integer := -9;

begin
   Translate (X, Y, Z, DX, DY, DZ);
   --  Each component is written with zero width, so the canonical form
   --  matches the topocli output whatever the signs.
   HAT.Put ("point ");
   HAT.Put (X, 0);
   HAT.Put (" ");
   HAT.Put (Y, 0);
   HAT.Put (" ");
   HAT.Put (Z, 0);
   HAT.New_Line;
end Translate_Demo;
