with "../../topoproof.gpr";

--  The client of the proved kernel: command-line parsing, input validation
--  and output formatting, including the --draw diagrams rendered by the
--  former topodraw sources. The kernel (topoproof.gpr) is the proved part;
--  this project keeps its run-time checks in every profile, because its
--  input validation relies on Constraint_Error for out-of-domain
--  parameters. Warnings are errors: a style violation or any other
--  warning fails every build, locally and in CI.
project Topocli is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "../../bin";
   for Main use ("topocli.adb");

   package Builder is
      for Executable ("topocli.adb") use "topocli";
   end Builder;

   --  Build profiles, selected with the same external as the kernel, so
   --  that one -X switch on the command line drives both projects.
   type Build_Profile_Kind is ("release", "development");
   Build_Profile : Build_Profile_Kind :=
     External ("Topoproof_Build_Profile", "development");

   Client_Switches := ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
                      "-gnatyabefhiklnprtx");
   --  Style checking: same set as the kernel, see topoproof.gpr.
   --  No maximum line length: GNATformat (width 100) owns the layout.

   package Compiler is
      case Build_Profile is
         when "release" =>
            for Default_Switches ("Ada") use
              Client_Switches & ("-O2", "-gnatVa");
         when others =>
            for Default_Switches ("Ada") use
              Client_Switches & ("-gnatVa", "-gnata");
      end case;
   end Compiler;

   package Format is
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "3";
      for Width ("Ada") use "100";
   end Format;

end Topocli;
