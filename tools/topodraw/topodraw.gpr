with "topodraw_lib.gpr";

project Topodraw is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/bin";
   for Exec_Dir use "bin";
   for Main use ("topodraw_main.adb");
   for Excluded_Source_Files use ("topodraw.ads", "topodraw.adb");
   package Builder is
      for Executable ("topodraw_main.adb") use "topodraw";
   end Builder;
end Topodraw;
