--  Library project of topodraw: the scene parser and the isometric SVG
--  renderer, without the command-line driver. TopoProof depends on this
--  project to generate diagrams from its own command lines (--draw).
project Topodraw_Lib is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj/lib";
   for Excluded_Source_Files use ("topodraw_main.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatVa", "-gnatf", "-gnatyabefhiklnprtx");
   end Compiler;
   package Format is
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "3";
      for Width ("Ada") use "100";
   end Format;
end Topodraw_Lib;
