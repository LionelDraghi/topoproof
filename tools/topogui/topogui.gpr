with "adi";

--  The graphical client of the proved kernel (DD-006). The kernel is
--  never rebuilt here: this project only builds the GUI front-end, and
--  keeps its run-time checks in every profile. Warnings are errors: a
--  style violation or any other warning fails every build.
project Topogui is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("topogui-main.adb");

   package Builder is
      for Executable ("topogui-main.adb") use "topogui";
   end Builder;

   type Build_Profile_Kind is ("release", "development");
   Build_Profile : Build_Profile_Kind :=
     External ("Topogui_Build_Profile", "development");

   --  Same style-checking set as the kernel and the client, so the
   --  three code bases compile with one single profile.
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatf",
         "-gnatyabefhiklnprtx");
   end Compiler;

   package Format is
      for Indentation ("Ada") use "3";
      for Indentation_Continuation ("Ada") use "3";
      for Width ("Ada") use "100";
   end Format;

end Topogui;
